# ============================================================================
# ZEDLUXE ORIGINALS — Environment variables
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# ============================================================================

# --- Supabase (public — safe in the browser; RLS protects the data) ---------
# Local dev values come from `supabase start` output. Production values come
# from the Supabase project dashboard (Settings → API).
# (local ports are 5433x to avoid clashing with other local Supabase projects)
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54331"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key-from-supabase-start>"

# --- Supabase service role (SERVER-ONLY — bypasses RLS) ---------------------
# Used by Route Handlers / Edge Functions for checkout, webhooks, admin writes.
# MUST NEVER be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-from-supabase-start>"

# --- Site URL (SEO: metadataBase, sitemap, robots, auth redirects) ----------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Paystack (Phase 8 — payments) ------------------------------------------
# Public key is browser-safe; secret key is SERVER-ONLY.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="<paystack-public-key>"
PAYSTACK_SECRET_KEY="<paystack-secret-key-server-only>"

# --- Cloudinary (Phase 9 — image host; chosen for launch, no card needed) ---
# Cloud name is public (builds delivery URLs in the browser).
# Upload preset is an UNSIGNED preset for the admin drag-and-drop (browser-safe).
# API key/secret are SERVER-ONLY (signed uploads / admin) — never NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="<cloudinary-unsigned-upload-preset>"
CLOUDINARY_API_KEY="<cloudinary-api-key-server-only>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret-server-only>"

# --- Cloudflare R2 (deferred scale-up — client's own account; SERVER-ONLY) --
# Enable later if image egress cost justifies it; flip asset_library.storage_provider.
# R2_ACCOUNT_ID="<r2-account-id>"
# R2_ACCESS_KEY_ID="<r2-access-key>"
# R2_SECRET_ACCESS_KEY="<r2-secret-key-server-only>"
# R2_BUCKET="zedluxe-public-assets"
# NEXT_PUBLIC_ASSET_BASE_URL="https://assets.zedluxe.com"

# --- Supabase DB password (CLI migrations only; SERVER-ONLY) ----------------
# SUPABASE_DB_PASSWORD="<db-password-from-dashboard-settings-database>"
